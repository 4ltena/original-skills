{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontend per-run metrics v1",
  "type": "object",
  "required": [
    "schema_version",
    "synthetic",
    "context",
    "build",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "context": {
      "type": "object",
      "required": [
        "environment_id",
        "scenario_id",
        "dataset_id",
        "cache_state",
        "instrumentation_id",
        "measurement_kind"
      ],
      "properties": {
        "environment_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "cache_state": {
          "type": "string",
          "minLength": 1
        },
        "instrumentation_id": {
          "type": "string",
          "minLength": 1
        },
        "measurement_kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "revision",
        "configuration"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "unit",
          "direction",
          "sample_unit",
          "samples"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "lower",
              "higher"
            ]
          },
          "sample_unit": {
            "const": "run"
          },
          "samples": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "run_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "description": "Runtime validator also enforces finite numbers, unique keys, run_ids count and exact comparison context."
}
