#!/usr/bin/python3
"""Run version-pinned, structurally bounded h5i reads."""

from __future__ import annotations

import os
import subprocess
import sys
from dataclasses import dataclass
from typing import Mapping, Sequence


EXIT_USAGE = 64
EXIT_TIMEOUT = 124
H5I = "/home/altena/.local/bin/h5i"
EXPECTED_VERSION = "h5i 0.2.8"
CAPTURE_READER = "/home/altena/.codex/skills/h5i-capture-read/scripts/h5i-read"


class H5iReadError(ValueError):
    pass


@dataclass(frozen=True)
class Grammar:
    min_positionals: int = 0
    max_positionals: int | None = None
    value_options: frozenset[str] = frozenset()
    flag_options: frozenset[str] = frozenset({"--help", "-h"})


COMMON_FLAGS = frozenset({
    "--help", "-h", "--json", "--no-color", "--all", "--verbose", "--quiet",
    "--summary", "--manifest", "--dry-run", "--follow",
})
COMMON_VALUES = frozenset({
    "--limit", "-l", "--since", "--until", "--before", "--after", "--format", "--query",
    "--id", "--object", "--run", "--timeout", "--interval", "--kind", "--status",
    "--author", "--branch", "--depth", "--ancestry",
})
FORBIDDEN_OPTION_NAMES = frozenset({
    "--apply", "--browser", "--config", "--edit", "--editor", "--exec", "--fix",
    "--force", "--hook", "--output", "-o", "--pager", "--pull", "--push",
    "--repair", "--shell", "--sync", "--upload", "--verify", "--write",
})
FORBIDDEN_WORDS = frozenset({
    "apply", "create", "delete", "edit", "exec", "fix", "force", "gc", "hook", "init",
    "install", "prune", "pull", "push", "remove", "repair", "restore", "run", "shell",
    "sync", "upload", "write",
})


def _grammar(min_pos: int = 0, max_pos: int | None = None, *, flags: frozenset[str] = COMMON_FLAGS,
             values: frozenset[str] = COMMON_VALUES) -> Grammar:
    return Grammar(min_pos, max_pos, values, flags)


GRAMMARS: dict[tuple[str, ...], Grammar] = {}

for name in ("log", "blame", "resume", "vibe", "maturity"):
    GRAMMARS[(name,)] = _grammar(0, 2)
for name in ("log", "blame", "context", "notes", "memory", "resume", "objects"):
    GRAMMARS[("recall", name)] = _grammar(0, 3)
GRAMMARS[("recall", "object")] = _grammar(1, 1)
for name in ("review", "scan", "vibe", "maturity"):
    GRAMMARS[("audit", name)] = _grammar(0, 2)
for name in ("check", "show"):
    GRAMMARS[("audit", "policy", name)] = _grammar(0, 1)
    GRAMMARS[("policy", name)] = _grammar(0, 1)
for name in (
    "probe", "capabilities", "list", "status", "doctor", "secrets", "ports", "log",
    "context", "diff", "inspect", "compare",
):
    GRAMMARS[("env", name)] = _grammar(0, 3)
for name in ("list", "trace", "status", "compare", "artifact"):
    GRAMMARS[("team", name)] = _grammar(0, 3)
GRAMMARS[("team", "bootstrap")] = _grammar(0, 0)
for name in ("history", "team", "replay", "wait", "watch"):
    GRAMMARS[("msg", name)] = _grammar(0, 3)
for name in ("get", "list", "fsck", "filters"):
    GRAMMARS[("objects", name)] = _grammar(0, 2)
for name in (
    "show", "status", "goal", "prompt", "scan", "diff", "relevant", "ephemeral",
    "cached-prefix", "todo", "dag", "search", "smart",
):
    GRAMMARS[("context", name)] = _grammar(0, 3)
for name in ("show", "uncertainty", "churn", "review", "omissions", "coverage"):
    GRAMMARS[("notes", name)] = _grammar(0, 3)
for name in ("log", "diff"):
    GRAMMARS[("memory", name)] = _grammar(0, 3)


def _option_name(token: str) -> str:
    return token.split("=", 1)[0]


def _match_path(argv: Sequence[str]) -> tuple[tuple[str, ...], Grammar, list[str]]:
    for width in (3, 2, 1):
        path = tuple(argv[:width])
        if path in GRAMMARS:
            return path, GRAMMARS[path], list(argv[width:])
    raise H5iReadError("command path is not an approved h5i read")


def _parse_args(args: Sequence[str], grammar: Grammar) -> tuple[list[str], set[str]]:
    positionals: list[str] = []
    seen_options: set[str] = set()
    index = 0
    after_separator = False
    while index < len(args):
        token = args[index]
        if token == "--" and not after_separator:
            after_separator = True
            index += 1
            continue
        if not after_separator and token.startswith("-"):
            name = _option_name(token)
            if name in FORBIDDEN_OPTION_NAMES:
                raise H5iReadError(f"option can mutate state or invoke an external helper: {name}")
            if name in grammar.flag_options:
                if "=" in token:
                    raise H5iReadError(f"flag does not take a value: {name}")
                seen_options.add(name)
                index += 1
                continue
            if name in grammar.value_options:
                seen_options.add(name)
                if "=" not in token:
                    index += 1
                    if index >= len(args) or args[index] == "--":
                        raise H5iReadError(f"option requires a value: {name}")
                index += 1
                continue
            raise H5iReadError(f"unknown option: {name}")
        normalized = token.lstrip("-").split("=", 1)[0].lower()
        if normalized in FORBIDDEN_WORDS:
            raise H5iReadError("mutation verb is not permitted as an argument")
        positionals.append(token)
        index += 1
    if len(positionals) < grammar.min_positionals:
        raise H5iReadError("missing required positional argument")
    if grammar.max_positionals is not None and len(positionals) > grammar.max_positionals:
        raise H5iReadError("too many positional arguments")
    return positionals, seen_options


def validate(argv: Sequence[str]) -> tuple[list[str], int]:
    if not argv:
        raise H5iReadError("missing h5i read command")
    if any("\0" in token for token in argv):
        raise H5iReadError("NUL is not permitted in argv")
    if argv[0] == "capture":
        if len(argv) == 1:
            raise H5iReadError("capture requires a reader command")
        return [H5I, "capture", "run", "--", CAPTURE_READER, *argv[1:]], 600
    path, grammar, args = _match_path(argv)
    positionals, options = _parse_args(args, grammar)
    if path in {("recall", "object"), ("objects", "get")}:
        formats = {name for name in options if name in {"--summary", "--manifest"}}
        if len(positionals) != 1 or len(formats) != 1:
            raise H5iReadError("object reads require one id and exactly one of --summary or --manifest")
    if path == ("objects", "fsck"):
        non_help = options - {"--help", "-h", "--json", "--no-color"}
        if positionals or non_help:
            raise H5iReadError("objects fsck permits display-only arguments")
    if path == ("objects", "filters") and "--verify" in options:
        raise H5iReadError("objects filters --verify is not read-only")
    if path == ("objects", "gc"):
        raise H5iReadError("objects gc is accepted only by its exact dry-run form")
    timeout = 600 if path in {("msg", "wait"), ("msg", "watch")} else 120
    return [H5I, *argv], timeout


def _validate_gc(argv: Sequence[str]) -> tuple[list[str], int] | None:
    if list(argv) == ["objects", "gc", "--dry-run"]:
        return [H5I, *argv], 120
    return None


def sanitized_env(source: Mapping[str, str] | None = None) -> dict[str, str]:
    inherited = os.environ if source is None else source
    env = {key: inherited[key] for key in ("HOME", "USER", "LOGNAME", "LANG", "LC_ALL", "TMPDIR", "TERM") if key in inherited}
    env.update({
        "PATH": "/home/altena/.codex/packages/standalone/releases/0.156.1-x86_64-unknown-linux-musl/codex-path:/usr/bin:/bin:/usr/sbin:/sbin",
        "GIT_OPTIONAL_LOCKS": "0", "GIT_PAGER": "cat", "PAGER": "cat",
    })
    return env


def _check_version(env: Mapping[str, str]) -> None:
    try:
        result = subprocess.run(
            [H5I, "--version"], capture_output=True, text=True, check=False, timeout=10, env=dict(env)
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise H5iReadError("unable to verify h5i version") from error
    output = (result.stdout or result.stderr).strip()
    if result.returncode != 0 or not output.startswith(EXPECTED_VERSION):
        raise H5iReadError("unsupported h5i version")


def run(argv: Sequence[str]) -> int:
    env = sanitized_env()
    _check_version(env)
    validated = _validate_gc(argv)
    command, timeout = validated if validated is not None else validate(argv)
    try:
        return subprocess.run(command, check=False, timeout=timeout, env=env).returncode
    except subprocess.TimeoutExpired:
        return EXIT_TIMEOUT
    except OSError as error:
        raise H5iReadError("unable to execute h5i") from error


def main() -> int:
    try:
        return run(sys.argv[1:])
    except H5iReadError as error:
        print(f"h5i-read: denied: {error}", file=sys.stderr)
        return EXIT_USAGE


if __name__ == "__main__":
    raise SystemExit(main())
